# ===== 智谱 GLM（OpenAI 兼容接口）=====
# 从 https://open.bigmodel.cn 控制台获取 API Key
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-5.2

# 无 GLM_API_KEY 时自动走 mock（离线启发式）；也可显式置 1 强制开启
LLM_MOCK=0

# ===== MongoDB =====
# 本地开发：mongodb://localhost:27017
# docker compose：由 compose 注入 mongodb://mongo:27017（无需在此设置）
MONGO_URL=mongodb://localhost:27017
MONGO_DB=research_agent

# ===== 对外地址（用于生成分享链接）=====
APP_BASE_URL=http://localhost:8080
