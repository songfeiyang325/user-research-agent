# ===== 智谱 GLM（OpenAI 兼容接口）=====
# 从 https://open.bigmodel.cn 控制台获取 API Key
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-5.2

# 无 GLM_API_KEY 时可开启 mock 模式，用启发式规则离线跑通全流程（1=开，0=关）
# 未配置 key 时会自动回退到 mock。
LLM_MOCK=0

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
# 用于生成对外分享链接
APP_BASE_URL=http://127.0.0.1:8000

# ===== 存储（SQLite，自包含）=====
DB_PATH=data/app.db
